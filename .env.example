# Copy to .env.local — NEVER commit real values.
# NEXT_PUBLIC_* vars are bundled into the browser — public-value-safe only.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only; bypasses RLS. Only consumed by (currently unused) createServiceClient.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudflare Turnstile widget (required for login/signup forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# finflow-api backend (required in prod; default http://localhost:3001 in dev)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ⚠️ HIGH-DEBT: these mirror API-side secrets but ship to the browser bundle.
# Prefer removal — see docs/DEBT.md. Required until consumers are refactored.
NEXT_PUBLIC_INTERNAL_API_SECRET=your_internal_api_secret
NEXT_PUBLIC_BOT_SECRET=your_webhook_secret

# PostHog analytics (optional; a hardcoded fallback key exists in lib/posthog.ts — see docs/DEBT.md)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Web push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
