# Copy to .env.local — NEVER commit real values.
# NEXT_PUBLIC_* vars are bundled into the browser — public-value-safe only.
# Note: the public Supabase vars are required at build time — pages are
# statically prerendered (see docs/DEPLOYMENT.md).

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile widget (required for login/signup forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# finflow-api backend (required in prod; default http://localhost:3001 in dev)
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostHog analytics (optional — telemetry is a no-op while unset, lib/posthog.ts:4-5)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Web push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
