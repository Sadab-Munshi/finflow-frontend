# Copy to .env.local — NEVER commit real values.
# NEXT_PUBLIC_* vars are bundled into the browser — public-value-safe only.
# Note: the public Supabase vars are required at build time — pages are
# statically prerendered (see docs/DEPLOYMENT.md).

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile widget (required for login/signup forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# finflow-api backend — SERVER-SIDE ONLY.
# The browser never calls the backend directly: client code requests /api/* on
# this app's own origin and app/api/[...path]/route.ts relays it, attaching the
# proxy secret. Do NOT reintroduce a NEXT_PUBLIC_ backend URL — anything with
# that prefix is inlined into the client bundle and shows up in the network tab.
# In dev this may stay unset (falls back to http://localhost:3001).
FINFLOW_API_ORIGIN=https://finflow-api.sadabmunshi.me

# Shared proxy secret. Must match PROXY_SECRET on the finflow-api host.
# Server-side only — never prefix this with NEXT_PUBLIC_.
FINFLOW_PROXY_SECRET=your_shared_proxy_secret

# DEPRECATED — kept only so existing deployments keep working during the
# migration; the proxy reads it as a fallback. Remove after cutover.
# NEXT_PUBLIC_API_URL=http://localhost:3001

# YOUPI PG Checkout Gateway (production tunnel on sadabmunshi.me)
NEXT_PUBLIC_YOUPI_CHECKOUT_URL=https://pay.sadabmunshi.me
NEXT_PUBLIC_YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001

# PostHog analytics (optional — telemetry is a no-op while unset, lib/posthog.ts:4-5)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Web push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
